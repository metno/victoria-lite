{
    "COSMO-Malawi": {
        "title": "COSMO-Malawi",
        "format": "nc-static",
        "domain": "global",
        "path": "/app/data/model_data/full2025-12-26.nc",
        "time_config": {
            "start_time": "2025-12-26T00:00:00",
            "interval_hours": 1,
            "duration_hours": 126
        },
        "variables": [
            "msl",
            "tp",
            "RELHUM_2M",
            "2t",
            "tcc"
        ],
        "vector_fields": {
            "wind_10m_vector": {
                "x": "10u",
                "y": "10v",
                "long_name": "Eastward wind",
                "units": "m/s",
                "dims": [
                    "time",
                    "lat",
                    "lon"
                ]
            }
        },
        "style_config": {
            "msl": {
                "title": "Mean sea level pressure",
                "style_category": "pressure",
                "unit_conversion": {
                    "scale": 0.01,
                    "offset": 0.0
                }
            },
            "tp": {
                "title": "Total Precipitation",
                "style_category": "amount",
                "unit_conversion": {
                    "scale": 1.0,
                    "offset": 0.0,
                    "deaccumulate": true
                }
            },
            "RELHUM_2M": {
                "title": "2m Relative Humidity",
                "style_category": "amount",
                "unit_conversion": {
                    "scale": 1.0,
                    "offset": 0.0,
                    "deaccumulate": true
                }
            },
            "2t": {
                "title": "Air temperature",
                "style_category": "temperature_C",
                "unit_conversion": {
                    "scale": 1.0,
                    "offset": -273.15
                }
            }
        },
        "keywords": [
            "bris",
            "malawi",
            "weather",
            "forecast"
        ]
    }
}